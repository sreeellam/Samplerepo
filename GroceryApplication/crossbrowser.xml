<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CrossBrowser">

	<test thread-count="5" name="ChromeTest">
		<parameter name="browsers" value="chrome"></parameter>
		<classes>

			<class name="mainproject.LoginTest">
				<methods>
					<include name="userLoginwithValidCredentials"></include>
				</methods>
			</class>
		</classes>
	</test>
	<test thread-count="5" name="FireFoxTest">
		<parameter name="browsers" value="FireFox"></parameter>
		<classes>

			<class name="mainproject.LoginTest">
				<methods>
					<include name="userLoginwithValidCredentials"></include>
				</methods>
			</class>
		</classes>
	</test>
	<test thread-count="5" name="SafariTest">
		<parameter name="browsers" value="safari"></parameter>
		<classes>

	       <class name="mainproject.LoginTest">
				<methods>
					<include name="userLoginwithValidCredentials"></include>
				</methods>
			</class>
		</classes>
	</test><!--
Test -->
</suite> <!--
Suite -->
